# SpeakMate AI Environment Configuration

PROJECT_NAME=SpeakMate AI
API_V1_STR=/api
SECRET_KEY=speakmate-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite default, PostgreSQL compatible)
DATABASE_URL=sqlite:///./speakmate.db

# AI Provider Configuration ('ollama', 'openai_compatible', 'builtin')
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Optional external LLM API
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Frontend Environment (in frontend/.env)
VITE_API_URL=http://localhost:8000/api
